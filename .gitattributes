# Test fixtures are byte-exact inputs: source digests, the run fingerprint,
# and the golden snapshot are all sha256 over these exact bytes. Never let
# the checkout translate their line endings (#45 — core.autocrlf=true turned
# every fixture CRLF on Windows and broke every digest comparison).
tests/fixtures/** -text

# Packaged browser resources must retain LF on Windows so their bytes and
# source-level safety checks stay identical regardless of core.autocrlf.
src/vault_cleaner/ui/*.css text eol=lf
src/vault_cleaner/ui/*.js text eol=lf
src/vault_cleaner/ui/*.html text eol=lf

